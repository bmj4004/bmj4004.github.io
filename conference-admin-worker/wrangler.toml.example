name = "bmj4004-conference-admin"
main = "src/index.js"
compatibility_date = "2026-09-07"

[vars]
SITE_ORIGIN = "https://bmj4004.github.io"
GITHUB_OWNER = "bmj4004"
GITHUB_REPO = "bmj4004.github.io"
GITHUB_BRANCH = "main"
GITHUB_DATA_PATH = "assets/data/sysvenues.json"
GITHUB_ADMIN = "bmj4004"

# Add these with `npx wrangler secret put NAME`; never put values in this file:
# GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET
# GITHUB_TOKEN       (fine-grained PAT: this repository, Contents read/write only)
# SESSION_SECRET     (at least 32 random characters)
